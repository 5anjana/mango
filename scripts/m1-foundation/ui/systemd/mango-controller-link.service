[Unit]
Description=Mango controller Bluetooth link supervisor (8BitDo Micro)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
# Identity and MAC come from mango-controller-link.service.d/10-tv-user.conf,
# written by install-controller-reliability.sh. Do not bake a donor user or MAC.
ExecStart=/usr/bin/python3 -c "raise SystemExit('mango-controller-link: install drop-in 10-tv-user.conf first')"
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
